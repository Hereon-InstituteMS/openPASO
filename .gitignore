# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/

# Virtual environment
.venv/

# Documents
papers/

# Solver source checkouts
/solvers/

# Generated outputs (created by tools at runtime)
simulation_outputs/
benchmarks/results/
benchmarks/coupling/
benchmarks/sweep_results/
meshes/

# Machine-specific settings (users create their own from settings.json.example)
.claude/settings.json
.claude/settings.local.json

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Large files
*.h5
*.hdf5
*.e
*.exo

# Secrets — never commit
.env
*.env
papers/.env

# Local quarantine directories (work-in-progress, not for release)
.quarantine_*
benchmarks/probe_results/work/
scripts/scan_results/work/

# Cloned upstream backend sources (large, machine-local)
upstream_sources/
data/source_discovery_cache.json
data/build_logs/
*.msh

# internal dev/paper docs — kept local, not published
/AGENTS.md
/CLAUDE.md
/E2E_POSTMORTEMS.md
/LAUNCH_PROMPTS.md
/PLAN.md
/SESSION_STATUS.md
/STRESS_TESTS.md
/TESTING_PROMPTS.md
/webui/TEST_PROMPTS.md
/benchmarks/probe_results/templates.md
benchmarks/coupling_pairs/*/build_dealii/

# Run artefacts. Every test run of the suite writes a session journal, and a
# SPARTA fixture leaves a log.sparta beside its working directory. Neither is
# source. Both were being swept up by `git add -A` and committed by accident.
# data/sessions/ keeps only its .gitkeep under version control.
log.sparta
/data/sessions/session_*.json
# Tier-2 fixtures write output files at run time; they are not inputs.
scripts/tier2_fixtures/**/*.vtu
scripts/tier2_fixtures/**/*.vtk
scripts/tier2_fixtures/**/_build/
.fxwork/
scripts/.cache/

# Machine-specific: written by autodiscovery on each install, never shipped.
data/discovered_config.json

# Audit outputs: regenerated by scripts/build_source_file_progress.py and
# scripts/upstream_source_audit.py. They index another machine, never ship.
data/source_file_progress.json
data/upstream_coverage.json
data/upstream_source_coverage.json

# The evaluation campaign and its records live on consolidation/v2, not on the
# product branch: they are one machine's run history, not something a user installs.
campaign3_blind/
validation/*/transcript.txt
data/blind_campaign_commitment.json
data/blind_key_commitment.json

# Tests of the evaluation campaign. They need campaign3_blind/, which lives on
# consolidation/v2, and they pass there. Keeping them here would ship a suite that
# cannot go green on a fresh clone.

# The agent's sandbox. Work directories, session scratch and sampled field data
# land here at run time; none of it is something a user installs.
eval_interactive/

# Worked couplings from the tier-2 coupling fixtures. Never shared, never
# committed: each one is a solved coupled problem.
.tier2_coupling_work/

# Recorded web-interface runs: prompts, model output and the local work
# directory of whoever ran them. Never product, and they carry home paths.
data/webui_sessions/

# npm install output; `npm ci` in ui/ recreates it from package-lock.json.
node_modules/

# Built documentation website (mkdocs build)
/site/

# the live per-event journal the server appends while a session runs
/data/sessions/session_*.jsonl
