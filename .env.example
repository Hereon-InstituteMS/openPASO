# ─────────────────────────────────────────────────────────────────────────
#  openPASO — your settings
#
#  Copy this file to ".env" and fill it in:
#      cp .env.example .env
#
#  The file ".env" stays on your computer. It is never uploaded, and git
#  ignores it.
# ─────────────────────────────────────────────────────────────────────────


# 1. YOUR OPENROUTER KEY                                         (required)
#
#    OpenRouter gives you one key for many AI models.
#      a) Make an account:  https://openrouter.ai
#      b) Create a key:     https://openrouter.ai/keys
#      c) Paste it below, right after the "=".
#         No quotation marks. No spaces.

OPENROUTER_API_KEY=


# 2. WHICH AI MODEL SHOULD DO THE WORK                           (required)
#
#    Pick any model from https://openrouter.ai/models that can use tools,
#    and copy its id exactly as that page writes it.
#
#    Good places to start:
#      deepseek/deepseek-v4.1-flash    low cost, a good first choice
#      qwen/qwen3.8-27b                small open-weight model, low cost
#      google/gemini-3.8-flash         fast, medium cost
#      anthropic/claude-sonnet-5       strongest results, higher cost
#
#    You pay OpenRouter for what you use. Start with a cheap model.

OPENPASO_MODEL=deepseek/deepseek-v4.1-flash


# 3. OPTIONAL SETTINGS
#
#    Leave these empty unless something does not work.

#    The Python that runs the openPASO server.
#    Empty means: use ./.venv/bin/python
OPENPASO_PYTHON=

#    The folder for results.
#    Empty means: use ./simulation_outputs
OPENPASO_OUTPUT_DIR=

#    Where your 4C build is, if you use the 4C solver.
FOURC_BINARY=
